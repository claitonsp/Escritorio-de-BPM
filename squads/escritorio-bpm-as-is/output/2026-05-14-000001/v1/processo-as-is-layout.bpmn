      <conditionExpression xsi:type="tFormalExpression">Sim</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sf-ativ05-ativ06" sourceRef="ativ-05" targetRef="ativ-06" />
    <sequenceFlow id="sf-ativ06-gw03" sourceRef="ativ-06" targetRef="gw-03" />
    <sequenceFlow id="sf-gw03-ativ07" name="Não" sourceRef="gw-03" targetRef="ativ-07">
      <conditionExpression xsi:type="tFormalExpression">Não</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sf-ativ07-ativ08" sourceRef="ativ-07" targetRef="ativ-08" />
    <sequenceFlow id="sf-gw03-ativ08" name="Sim" sourceRef="gw-03" targetRef="ativ-08">
      <conditionExpression xsi:type="tFormalExpression">Sim</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sf-ativ08-ativ09" sourceRef="ativ-08" targetRef="ativ-09" />
    <sequenceFlow id="sf-ativ09-ativ10" sourceRef="ativ-09" targetRef="ativ-10" />
    <sequenceFlow id="sf-ativ10-ativ11" sourceRef="ativ-10" targetRef="ativ-11" />
    <sequenceFlow id="sf-ativ11-gw04" sourceRef="ativ-11" targetRef="gw-04" />
    <sequenceFlow id="sf-gw04-ativ12" name="Tudo certo" sourceRef="gw-04" targetRef="ativ-12">
      <conditionExpression xsi:type="tFormalExpression">Tudo certo</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sf-gw04-ativ13" name="Divergência" sourceRef="gw-04" targetRef="ativ-13">
      <conditionExpression xsi:type="tFormalExpression">Divergência</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sf-ativ12-ativ14" sourceRef="ativ-12" targetRef="ativ-14" />
    <sequenceFlow id="sf-ativ14-ativ15" sourceRef="ativ-14" targetRef="ativ-15" />
    <sequenceFlow id="sf-ativ15-ev02" sourceRef="ativ-15" targetRef="ev-02" />
    <sequenceFlow id="sf-ativ13-ev04" sourceRef="ativ-13" targetRef="ev-04" />
  </process>

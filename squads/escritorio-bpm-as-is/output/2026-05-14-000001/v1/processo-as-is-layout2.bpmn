    </sequenceFlow>
    <sequenceFlow id="sf-ativ05-ativ06" sourceRef="ativ-05" targetRef="ativ-06" />
    <sequenceFlow id="sf-ativ06-gw03" sourceRef="ativ-06" targetRef="gw-03" />
    <sequenceFlow id="sf-gw03-ativ07" name="Não" sourceRef="gw-03" targetRef="ativ-07">

    </sequenceFlow>
    <sequenceFlow id="sf-ativ07-ativ08" sourceRef="ativ-07" targetRef="ativ-08" />
    <sequenceFlow id="sf-gw03-ativ08" name="Sim" sourceRef="gw-03" targetRef="ativ-08">
      <conditionExpression xsi:type="tFormalExpression">Sim</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sf-ativ08-ativ09" sourceRef="ativ-08" targetRef="ativ-09" />

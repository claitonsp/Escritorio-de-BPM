<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="definitions_tobe" targetNamespace="http://escritorio-bpm/tobe">
  <process id="proc_tobe" name="Processo de Aprovação de Compra — TO-BE" isExecutable="false">
    <laneSet id="ls_01">
      <lane id="lane-ator-01" name="Solicitante">
        <flowNodeRef>ev-01</flowNodeRef>
        <flowNodeRef>ativ-01</flowNodeRef>
      </lane>
      <lane id="lane-ator-02" name="Supervisor">
        <flowNodeRef>ativ-02</flowNodeRef>
        <flowNodeRef>gw-01</flowNodeRef>
      </lane>
      <lane id="lane-ator-03" name="Gerente de Compras">
        <flowNodeRef>ativ-03</flowNodeRef>
        <flowNodeRef>ativ-04</flowNodeRef>
        <flowNodeRef>ativ-05</flowNodeRef>
        <flowNodeRef>ativ-06</flowNodeRef>
        <flowNodeRef>ativ-08</flowNodeRef>
        <flowNodeRef>ativ-09</flowNodeRef>
        <flowNodeRef>ativ-13</flowNodeRef>
        <flowNodeRef>ativ-16</flowNodeRef>
        <flowNodeRef>ativ-18</flowNodeRef>
        <flowNodeRef>gw-02</flowNodeRef>
        <flowNodeRef>gw-03</flowNodeRef>
        <flowNodeRef>gw-05</flowNodeRef>
        <flowNodeRef>ev-03</flowNodeRef>
        <flowNodeRef>ev-06</flowNodeRef>
      </lane>
      <lane id="lane-ator-05" name="Setor de Cadastro">
        <flowNodeRef>ativ-07</flowNodeRef>
      </lane>
      <lane id="lane-ator-04" name="Fornecedor">
        <flowNodeRef>ativ-10</flowNodeRef>
      </lane>
      <lane id="lane-ator-06" name="Almoxarifado">
        <flowNodeRef>ativ-11</flowNodeRef>
        <flowNodeRef>ativ-12</flowNodeRef>
        <flowNodeRef>ativ-14</flowNodeRef>
        <flowNodeRef>ativ-17</flowNodeRef>
        <flowNodeRef>gw-04</flowNodeRef>
        <flowNodeRef>ev-05</flowNodeRef>
      </lane>
      <lane id="lane-ator-07" name="Financeiro">
        <flowNodeRef>ativ-15</flowNodeRef>
        <flowNodeRef>ev-02</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="ev-01" name="Necessidade de compra" />
    <userTask id="ativ-01" name="Preencher formulário de requisição" />
    <userTask id="ativ-02" name="Aprovar requisição" />
    <exclusiveGateway id="gw-01" name="Valor da compra" />
    <userTask id="ativ-03" name="Verificar disponibilidade de orçamento" />
    <exclusiveGateway id="gw-02" name="Disponibilidade de orçamento" />
    <userTask id="ativ-04" name="Devolver requisição com justificativa" />
    <endEvent id="ev-03" name="Requisição devolvida (sem orçamento)" />
    <userTask id="ativ-05" name="Pedir três cotações aos fornecedores" />
    <userTask id="ativ-16" name="Registrar comparativo de cotações e selecionar fornecedor" />
    <serviceTask id="ativ-06" name="Validar cadastro do fornecedor automaticamente" />
    <exclusiveGateway id="gw-03" name="Fornecedor cadastrado" />
    <userTask id="ativ-07" name="Incluir fornecedor no sistema" />
    <userTask id="ativ-08" name="Emitir pedido de compra" />
    <serviceTask id="ativ-09" name="Enviar notificação automática ao fornecedor" />
    <userTask id="ativ-10" name="Confirmar prazo de entrega" />
    <userTask id="ativ-11" name="Conferir nota fiscal contra pedido" />
    <exclusiveGateway id="gw-04" name="Conferência da nota fiscal" />
    <userTask id="ativ-12" name="Dar entrada no estoque" />
    <userTask id="ativ-13" name="Resolver divergência na entrega" />
    <exclusiveGateway id="gw-05" name="Resolução da divergência" />
    <userTask id="ativ-17" name="Devolver mercadoria ao fornecedor" />
    <userTask id="ativ-18" name="Escalar divergência para Diretoria" />
    <serviceTask id="ativ-14" name="Gerar documento de pagamento automaticamente" />
    <userTask id="ativ-15" name="Quitar pagamento" />
    <endEvent id="ev-02" name="Pagamento efetuado" />
    <endEvent id="ev-05" name="Mercadoria devolvida ao fornecedor" />
    <endEvent id="ev-06" name="Caso escalado para Diretoria" />
    <sequenceFlow id="sf-ev01-ativ01" sourceRef="ev-01" targetRef="ativ-01" />
    <sequenceFlow id="sf-ativ01-ativ02" sourceRef="ativ-01" targetRef="ativ-02" />
    <sequenceFlow id="sf-ativ02-gw01" sourceRef="ativ-02" targetRef="gw-01" />

    </sequenceFlow>
    <sequenceFlow id="sf-gw05-ativ17" name="Devolução ao fornecedor" sourceRef="gw-05" targetRef="ativ-17">
      <conditionExpression xsi:type="tFormalExpression">Devolução ao fornecedor</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sf-gw05-ativ18" name="Escalada para Diretoria" sourceRef="gw-05" targetRef="ativ-18">
      <conditionExpression xsi:type="tFormalExpression">Escalada para Diretoria</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sf-ativ12-ativ14" sourceRef="ativ-12" targetRef="ativ-14" />

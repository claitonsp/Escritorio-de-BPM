    <bpmndi:BPMNShape id="ev-04_di" bpmnElement="ev-04">
      <dc:Bounds x="762" y="42" width="36" height="36" />
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="ev-05_di" bpmnElement="ev-05">
      <dc:Bounds x="222" y="862" width="36" height="36" />
    </bpmndi:BPMNShape>

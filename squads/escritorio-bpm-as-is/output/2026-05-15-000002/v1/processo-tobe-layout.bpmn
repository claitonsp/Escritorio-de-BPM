      <dc:Bounds x="575" y="515" width="50" height="50" />
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="gw-08_di" bpmnElement="gw-08" isMarkerVisible="true">
      <dc:Bounds x="395" y="975" width="50" height="50" />
    </bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="sf-ev01-ativ01_di" bpmnElement="sf-ev01-ativ01">
      <di:waypoint x="258" y="60" />
      <di:waypoint x="360" y="60" />
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="sf-ativ01-gw01_di" bpmnElement="sf-ativ01-gw01">
      <di:waypoint x="480" y="60" />
      <di:waypoint x="528" y="60" />
      <di:waypoint x="528" y="180" />
      <di:waypoint x="575" y="180" />
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="sf-gw01-ativ02_di" bpmnElement="sf-gw01-ativ02">
      <di:waypoint x="625" y="180" />
      <di:waypoint x="720" y="240" />
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="sf-gw01-ev04_di" bpmnElement="sf-gw01-ev04">
      <di:waypoint x="625" y="180" />
      <di:waypoint x="694" y="180" />
      <di:waypoint x="694" y="60" />
      <di:waypoint x="762" y="60" />
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="sf-ativ02-ativ03_di" bpmnElement="sf-ativ02-ativ03">
      <di:waypoint x="840" y="240" />
      <di:waypoint x="900" y="360" />
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="sf-ativ03-gw02_di" bpmnElement="sf-ativ03-gw02">
      <di:waypoint x="1020" y="360" />
